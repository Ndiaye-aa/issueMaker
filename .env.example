# ==============================================================================
# sdd-bot — configuração de ambiente
#
# 1) Copie este arquivo para .env (nunca commitado — ver .gitignore):
#      cp .env.example .env
# 2) Preencha as variáveis abaixo
# 3) Instale as dependências e compile:
#      npm install
#      npm run build
# ==============================================================================

# --- Provedor principal de IA (camada gratuita) ---
GROQ_API_KEY=

# Modelo Groq usado nas chamadas de IA (opcional — default: openai/gpt-oss-120b).
# A Groq descontinua/renomeia modelos periodicamente; se receber erro 404
# "model does not exist", consulte https://console.groq.com/docs/models
# para ver o catálogo atual e defina outro modelo aqui sem precisar mexer no código.
GROQ_MODEL=

# --- Fallback local (Ollama) ---
# Assume automaticamente o restante do pipeline quando o Groq responde rate limit / cota
# esgotada (HTTP 429). Requer o Ollama rodando (`ollama serve`) e o modelo baixado:
#      ollama pull qwen2.5:3b-instruct
# Tempo aproximado de um `process` (SDD de ~36k chars) em CPU sem GPU, 14–16 GB de RAM:
#   qwen2.5:3b-instruct  ~1h15–1h45  (default; qualidade razoável)
#   qwen2.5:7b-instruct  ~2h15–2h45  (melhor extração)
#   qwen2.5:14b-instruct inviável sem GPU
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# --- Necessário apenas para o comando `publish` ---
# Personal Access Token do GitHub com permissão de escrita em issues
# (classic token com escopo "repo", ou fine-grained com "Issues: read and write")
# Gere em https://github.com/settings/tokens
GITHUB_TOKEN=

# npm run dev -- process --file <file.extention> --sprint-length "sprint duration(weeks/days)"
