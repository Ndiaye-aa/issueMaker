# ==============================================================================
# sdd-bot — configuração de ambiente
#
# 1) Copie este arquivo para .env (nunca commitado — ver .gitignore):
#      cp .env.example .env
# 2) Preencha as variáveis abaixo (com AI_PRIMARY=claude-code e login no Claude Code feito,
#    nenhuma chave é obrigatória)
# 3) Instale as dependências e compile:
#      npm install
#      npm run build
# ==============================================================================

# --- Provedores de IA ---
# Principal e fallback, escolhidos entre: claude-code | openai | groq | ollama.
# O fallback assume o restante do pipeline quando o principal responde rate limit / cota
# esgotada. AI_FALLBACK=none desliga o fallback. Os dois não podem ser iguais.
AI_PRIMARY=claude-code
AI_FALLBACK=ollama

# [claude-code] Claude pela própria máquina, via Agent SDK (binário do Claude Code embutido).
# Sem ANTHROPIC_API_KEY, usa o login já feito no Claude Code desta máquina (`claude` → /login),
# como o Ollama: nenhuma chave no .env. Com ANTHROPIC_API_KEY definida, a chave tem prioridade.
# Aviso: a Anthropic não permite que terceiros ofereçam login do claude.ai em produtos feitos
# com o Agent SDK — use este modo para uso pessoal; para distribuir, use ANTHROPIC_API_KEY.
CLAUDE_MODEL=claude-sonnet-5
# Aborta uma chamada travada (ms). Default: 600000 (10 min).
CLAUDE_TIMEOUT_MS=600000
# Modelo para decisões mecânicas/binárias (ex.: confirmar duplicata de requisito) — mais
# barato e mais rápido que CLAUDE_MODEL. Default: claude-haiku-4-5-20251001.
# CLAUDE_LIGHT_MODEL=claude-haiku-4-5-20251001
# Esforço de raciocínio: low | medium | high | xhigh | max. Todas as chamadas do pipeline
# são formatação de saída estruturada a partir de um prompt já detalhado — raciocínio
# estendido só custa tokens extras. Default: low.
# CLAUDE_EFFORT=low
# Raciocínio estendido: disabled | adaptive. Default: disabled.
# CLAUDE_THINKING=disabled
# ANTHROPIC_API_KEY=

# [groq] Camada gratuita da Groq (era o principal fixo nas versões anteriores).
GROQ_API_KEY=
# Modelo (opcional — default: openai/gpt-oss-120b). A Groq descontinua/renomeia modelos;
# se receber 404 "model does not exist", consulte https://console.groq.com/docs/models.
GROQ_MODEL=

# [openai] Qualquer API compatível com chat/completions da OpenAI: OpenAI, OpenRouter,
# Together, Mistral, DeepSeek... Ex.: OpenRouter → OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# [ollama] Local, sem chave. Requer o Ollama rodando (`ollama serve`) e o modelo baixado:
#      ollama pull qwen2.5:3b-instruct
# Tempo aproximado de um `process` (SDD de ~36k chars) em CPU sem GPU, 14–16 GB de RAM:
#   qwen2.5:3b-instruct  ~1h15–1h45  (default; qualidade razoável)
#   qwen2.5:7b-instruct  ~2h15–2h45  (melhor extração)
#   qwen2.5:14b-instruct inviável sem GPU
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# --- Desempenho / cache (opcionais) ---
# Chamadas simultâneas ao provedor principal (extração de chunks, confirmações de duplicata
# e lotes de backlog rodam em paralelo). O Ollama é sempre serial. Default: 3.
AI_CONCURRENCY=3
# Quantos requisitos da mesma sprint entram numa única chamada de geração de backlog. O
# system prompt do backlog é a maior fatia de tokens do pipeline e é reenviado a cada
# chamada — lotes maiores economizam bastante. Forçado a 1 quando o provedor principal é
# ollama (modelos pequenos/locais perdem rigor com vários requisitos por prompt). Default: 4.
BACKLOG_BATCH_SIZE=4
# Cache em disco das respostas de IA, chaveado por prompt + schema + modelo. Reexecutar o
# pipeline sobre o mesmo SDD reaproveita tudo que já foi gerado (custo zero, instantâneo).
# Desligue com SDD_BOT_CACHE=0 ou --no-cache; mude o diretório com SDD_BOT_CACHE_DIR.
SDD_BOT_CACHE=1
SDD_BOT_CACHE_DIR=.sdd-bot-cache

# --- Necessário apenas para o comando `publish` ---
# Personal Access Token do GitHub com permissão de escrita em issues
# (classic token com escopo "repo", ou fine-grained com "Issues: read and write")
# Gere em https://github.com/settings/tokens
GITHUB_TOKEN=

# npm run dev -- process --file <file.extention> --sprint-length "sprint duration(weeks/days)"
